# rag anything
LLM_BINDING_HOST=http://127.0.0.1:8100/v1
LLM_MODEL=/hdd/lmq/model/Qwen3-VL-8B-Instruct
VLLM_BINDING_HOST=http://127.0.0.1:8100/v1
VLLM_MODEL=/hdd/lmq/model/Qwen3-VL-8B-Instruct
EMBEDDING_MODEL=/hdd/lmq/model/bge-m3
EMBEDDING_BINDING_HOST=http://127.0.0.1:8001/v1

# folder with this name will be created for intermediate results
BENCHMARK_NAME=UNIDOCBENCH_0713_retry
BENCH_FORCE_RERUN=true

# path to queries
BENCH_QUERIES=queries_30.json




# judger: model used for rag-system answer evaluation
JUDGER_API_KEY="api-key"
JUDGER_BINDING_HOST=http://127.0.0.1:8100/v1
JUDGER_MODEL=/hdd/lmq/model/Qwen3-VL-8B-Instruct

# rarank model used to rerank retrieved chunks
RERANK_MODEL=/hdd/lmq/model/bge-reranker-v2-m3
RERANK_ENDPOINT=http://127.0.0.1:8002/v1/rerank
RERANK_API_KEY="api-key"
RERANK_TOP_N=10

# topk value for chunks from vdb
CHUNK_TOPK=40

# topk value for entities and relations from its databases
ENTITY_TOPK=30
QUERY_MAX_ENTITY_TOKENS=600
QUERY_MAX_RELATION_TOKENS=600
QUERY_MAX_TOTAL_TOKENS=126000
QUERY_MAX_TOKENS=512
QUERY_VLM_ENHANCED=true

# output folder for building rag index 
RAG_STORAGE=RAG_STORAGE_0713_retry

# path to parsed documents(by minerU), currently all tests are held with using *_content_list.json output from minerU parser
# DOC_FILE_PATH=TEST_parser_output
DOC_FILE_PATH=mineru-parsed


# address where simple local server will be started.
RAG_BINDING_HOST=http://127.0.0.1:8080/query

# mode for rag query there is also hybrid, naive ...
QUERY_MODE=mix

# path for logs
LOG_DIR=./all_logs

# lightrag and rag-anything specific parameters

EMBEDDING_DIM=1024
EMBEDDING_SEND_DIM=false
CHUNK_SIZE=300
CHUNK_OVERLAP_SIZE=15
MAX_CONCURRENT_FILES=1
MAX_TOKEN_TEXT_CHUNK=500
MAX_TOKEN_RELATION_DESC=500
MAX_TOKEN_ENTITY_DESC=500
WORKERS=1
MAX_ASYNC=1
LLM_TIMEOUT=1200
MAX_TOKENS=1024
TEMPERATURE=0
MAX_GLEANING=0
MAX_EXTRACTION_RECORDS=40
MAX_EXTRACTION_ENTITIES=20
EMBEDDING_FUNC_MAX_ASYNC=8

# path to raw pdf files
DOCS_PATH=rag-anything-experiments/doc_for_e2e_test
# parser tool
PARSER_NAME=mineru
# output folder where mineru will put output files
# PARSER_OUTPUT_DIR=TEST_parser_output
PARSER_OUTPUT_DIR=mineru-parsed

# if true - vlm backend, false - pipeline, for details: see minerU help
MINERU_VLM=false
SKIP_FILE_PATHS=

MAX_TOTAL_TOKENS=126000


DEFAULT_MAX_TOTAL_TOKENS=30000
BASELINE_SEARCH_TIME=x
BASELINE_BUILD_TIME=y